{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/algorithm-diagram-ir.schema.json",
  "title": "Algorithm Diagram Semantic IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "canvas", "assets", "elements"],
  "properties": {
    "version": { "const": "1.0" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "metadata": { "type": "object" },
    "styles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/style" },
      "default": {}
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/asset" }
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/group" },
          { "$ref": "#/$defs/shape" },
          { "$ref": "#/$defs/text" },
          { "$ref": "#/$defs/image" },
          { "$ref": "#/$defs/connector" }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/alignConstraint" },
          { "$ref": "#/$defs/equalGapConstraint" },
          { "$ref": "#/$defs/sameSizeConstraint" },
          { "$ref": "#/$defs/containConstraint" },
          { "$ref": "#/$defs/noOverlapConstraint" }
        ]
      },
      "default": []
    },
    "qa_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/qaRegion" },
      "default": []
    }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "$ref": "#/$defs/color" },
        "grid": { "type": "number", "exclusiveMinimum": 0 },
        "slide_width_in": { "type": "number", "exclusiveMinimum": 0 },
        "slide_height_in": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": { "$ref": "#/$defs/color" },
        "fill_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "stroke": { "$ref": "#/$defs/color" },
        "stroke_width": { "type": "number", "minimum": 0 },
        "stroke_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash": { "enum": ["solid", "dash", "dot", "dash_dot"] },
        "start_arrow": { "enum": ["none", "triangle", "stealth", "diamond", "circle"] },
        "end_arrow": { "enum": ["none", "triangle", "stealth", "diamond", "circle"] },
        "color": { "$ref": "#/$defs/color" },
        "font_family": { "type": "string" },
        "font_size": { "type": "number", "exclusiveMinimum": 0 },
        "font_weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "italic": { "type": "boolean" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "valign": { "enum": ["top", "middle", "bottom"] },
        "padding": { "type": "number", "minimum": 0 },
        "line_spacing": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "mime", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "mime": { "enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp", "image/gif"] },
        "alt": { "type": "string", "minLength": 1 },
        "intrinsic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "number", "exclusiveMinimum": 0 },
            "h": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "source_url": { "type": "string" },
        "license": { "type": "string" },
        "draft_crop": { "type": "string" }
      }
    },
    "port": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "side", "offset"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "side": { "enum": ["left", "right", "top", "bottom"] },
            "offset": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "x", "y"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      ]
    },
    "common": {
      "type": "object",
      "required": ["id", "kind", "z"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "type": "string" },
        "parent": { "type": "string" },
        "role": { "type": "string" },
        "z": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "allow_overflow": { "type": "boolean" },
        "style_ref": { "type": "string" },
        "rotation": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "group": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "frame", "z"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "kind": { "const": "group" },
            "parent": { "type": "string" },
            "role": { "type": "string" },
            "frame": { "$ref": "#/$defs/frame" },
            "z": { "type": "integer" },
            "visible": { "type": "boolean" },
            "locked": { "type": "boolean" },
            "allow_overflow": { "type": "boolean" },
            "style_ref": { "type": "string" },
            "style": { "$ref": "#/$defs/style" },
            "rotation": { "type": "number" },
            "clip": { "type": "boolean" },
            "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
            "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["rect", "round_rect", "ellipse", "diamond", "parallelogram", "hexagon", "chevron", "trapezoid", "line"] },
            "radius": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "points"],
          "properties": {
            "type": { "const": "polygon" },
            "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "svg_path"],
          "properties": {
            "type": { "const": "path" },
            "svg_path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "frame", "z", "geometry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "const": "shape" },
        "parent": { "type": "string" },
        "role": { "type": "string" },
        "frame": { "$ref": "#/$defs/frame" },
        "z": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "allow_overflow": { "type": "boolean" },
        "style_ref": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "rotation": { "type": "number" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "frame", "z", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "const": "text" },
        "parent": { "type": "string" },
        "role": { "type": "string" },
        "frame": { "$ref": "#/$defs/frame" },
        "z": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "allow_overflow": { "type": "boolean" },
        "style_ref": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "rotation": { "type": "number" },
        "text": { "type": "string" },
        "auto_fit": { "enum": ["none", "shrink", "resize"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "right": { "type": "number", "minimum": 0, "maximum": 1 },
        "top": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "frame", "z", "asset_id", "fit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "const": "image" },
        "parent": { "type": "string" },
        "role": { "type": "string" },
        "frame": { "$ref": "#/$defs/frame" },
        "z": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "allow_overflow": { "type": "boolean" },
        "rotation": { "type": "number" },
        "asset_id": { "type": "string" },
        "fit": { "enum": ["contain", "cover", "stretch"] },
        "crop": { "$ref": "#/$defs/crop" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element", "port"],
      "properties": {
        "element": { "type": "string" },
        "port": { "type": "string" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "z", "from", "to", "route"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "kind": { "const": "connector" },
        "parent": { "type": "string" },
        "role": { "type": "string" },
        "z": { "type": "integer" },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "style_ref": { "type": "string" },
        "style": { "$ref": "#/$defs/style" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "route": { "enum": ["straight", "orthogonal", "polyline", "curve"] },
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "avoid": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "alignConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "axis", "items"],
      "properties": {
        "kind": { "const": "align" },
        "axis": { "enum": ["left", "right", "top", "bottom", "center_x", "center_y"] },
        "items": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "equalGapConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "axis", "items"],
      "properties": {
        "kind": { "const": "equal_gap" },
        "axis": { "enum": ["x", "y"] },
        "items": { "type": "array", "minItems": 3, "items": { "type": "string" }, "uniqueItems": true },
        "gap": { "type": "number", "minimum": 0 },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "sameSizeConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "dimension", "items"],
      "properties": {
        "kind": { "const": "same_size" },
        "dimension": { "enum": ["width", "height", "both"] },
        "items": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "containConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "container", "items"],
      "properties": {
        "kind": { "const": "contain" },
        "container": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "padding": { "type": "number", "minimum": 0 },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "noOverlapConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "no_overlap" },
        "items": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "gap": { "type": "number", "minimum": 0 },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "qaRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame", "element_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "frame": { "$ref": "#/$defs/frame" },
        "draft_crop": { "type": "string" },
        "element_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
